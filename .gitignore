# Local agent skills
.agents/

# Secrets. Examples stay tracked.
.env
.env.*
!.env.example

# Python bytecode and packaging
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments, wherever the app is checked out
.venv/
venv/
env/
ENV/

# Test, type-check, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# VoiceMint runtime files
# Linux writes logs/ from the working directory, history.json under history/,
# and config.json beside the app. The macOS terminal app does not write these.
logs/
*.log
history.json
config.json

